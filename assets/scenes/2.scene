Scene:
  Entities:
    - Name: PhysicsBall
      Transform:
        Translation: [0, 5, 0]
        Rotation: [0, 0, 0]
        Scale: [0.5, 0.5, 0.5]
      MeshRenderer:
        Color: [0.2, 0.6, 1, 1]
        Mesh: builtin:sphere
      RigidBody:
        Type: Kinematic
        Mass: 1
        Friction: 0.6
        Restitution: 0.3
        LinearDamping: 0.05
        AngularDamping: 0.05
